# ==============================================================================
# LLM Provider Configuration
# Leave all empty to use the built-in deterministic mock summary.
# ==============================================================================

# --- Option 1: GroqCloud (FREE TIER - Recommended) ---
# Sign up at https://console.groq.com and generate a free API key (starts with gsk_...)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Alternative fast model: GROQ_MODEL=llama-3.1-8b-instant

# --- Option 2: OpenAI (Paid alternative) ---
# Set OPENAI_API_KEY with your OpenAI key (starts with sk-...)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
